<Window x:Class="SmartX.Dashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartX-IoT-Mesh Gateway Control Console (Part 2)" Height="880" Width="1240"
        MinHeight="750" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A" Foreground="#F8FAFC"
        FontFamily="Segoe UI, Roboto, sans-serif">

    <Window.Resources>
        <!-- Top Pillar Nav Button Style -->
        <Style x:Key="PillarNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active Pillar Highlight Style -->
        <Style x:Key="ActivePillarButtonStyle" BasedOn="{StaticResource PillarNavButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#60A5FA"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <!-- Primary Action Button -->
        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button (Emergency/Alert) -->
        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DC2626"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Undo Button Style -->
        <Style x:Key="UndoButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#8B5CF6"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#7C3AED"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Form Label Style -->
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>

        <!-- Form TextBox Style -->
        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="CaretBrush" Value="#3B82F6"/>
        </Style>

        <!-- Metric Card Style -->
        <Style x:Key="MetricCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Header & 3-Pillar Navigation -->
            <RowDefinition Height="*"/>    <!-- Active Module Content (Pillar 1, 2, or 3) -->
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- HEADER & 3-PILLAR NAVIGATION BAR                               -->
        <!-- ============================================================== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <!-- Header Title & User Status -->
            <DockPanel Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="SmartX-IoT-Mesh Edge Gateway" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="Real-Time Processing Engine &amp; Advanced Data Structure Device Management" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Border Background="#1E293B" CornerRadius="20" Padding="12,6" BorderBrush="#334155" BorderThickness="1" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ApiStatusIndicator" Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0"/>
                            <TextBlock x:Name="ApiStatusTextBlock" Text="API: Ready (http://localhost:5000)" FontSize="11" Foreground="#94A3B8"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#1E293B" CornerRadius="20" Padding="12,6" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤 admin@smartx.io" FontSize="11" FontWeight="SemiBold" Foreground="#60A5FA" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <Button Content="Logout" Click="LogoutButton_Click" Background="#EF4444" Foreground="#FFFFFF" 
                                    FontSize="10" FontWeight="Bold" Padding="10,4" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>

            <!-- 3-Pillar Menu Bar (Requirement: Organised navigation presenting the 3 modules) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Pillar 1: Sensor Data Ingestion and Telemetry (Part 1) -->
                <Button x:Name="NavPillar1Button" Grid.Column="0" 
                        Content="1. Sensor Data Ingestion &amp; Telemetry" 
                        Click="NavPillar1_Click"
                        Style="{StaticResource PillarNavButtonStyle}" Margin="0,0,6,0"/>
                
                <!-- Pillar 2: Real-Time Command Stream and History (Part 2 - Now Enabled!) -->
                <Button x:Name="NavPillar2Button" Grid.Column="1" 
                        Content="2. Real-Time Command Stream &amp; History" 
                        Click="NavPillar2_Click"
                        Style="{StaticResource ActivePillarButtonStyle}" Margin="3,0,3,0"/>
                
                <!-- Pillar 3: Network Topology and Mesh Routing (PoE Final Preview) -->
                <Button x:Name="NavPillar3Button" Grid.Column="2" 
                        Content="3. Network Topology &amp; Mesh Routing" 
                        Click="NavPillar3_Click"
                        Style="{StaticResource PillarNavButtonStyle}" Margin="6,0,0,0"/>
            </Grid>
        </StackPanel>

        <!-- ============================================================== -->
        <!-- MODULE 1: SENSOR DATA INGESTION & TELEMETRY (PART 1 PRESERVED)  -->
        <!-- ============================================================== -->
        <Grid x:Name="Pillar1IngestionGrid" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/> <!-- Left: Form Input Panel -->
                <ColumnDefinition Width="*"/>   <!-- Right: Dynamic Heatmap & Console -->
            </Grid.ColumnDefinitions>

            <!-- LEFT: PAYLOAD FORM PANEL -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Padding="20" Margin="0,0,16,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Telemetry Dispatch Form (Part 1 Ingestion)" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,12"/>
                        <Rectangle Height="1" Fill="#334155" Margin="0,0,0,16"/>

                        <!-- MAC Address -->
                        <TextBlock Text="MAC ADDRESS" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="MacAddressTextBox" Text="00:1A:2C:3F:4E:56" Style="{StaticResource FormTextBoxStyle}"/>

                        <!-- Location -->
                        <TextBlock Text="DEPLOYMENT LOCATION / ZONE" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="LocationTextBox" Text="Sector-7 / Greenhouse-A" Style="{StaticResource FormTextBoxStyle}"/>

                        <!-- Category ComboBox -->
                        <TextBlock Text="TELEMETRY CATEGORY" Style="{StaticResource FormLabelStyle}"/>
                        <ComboBox x:Name="CategoryComboBox" SelectedIndex="0" Margin="0,0,0,10" Background="#0F172A" Foreground="#0F172A">
                            <ComboBoxItem Content="Environmental"/>
                            <ComboBoxItem Content="Power"/>
                            <ComboBoxItem Content="Actuator"/>
                            <ComboBoxItem Content="Hydroponics"/>
                        </ComboBox>

                        <!-- Telemetry Value -->
                        <TextBlock Text="PAYLOAD VALUE (NUMERIC THRESHOLD)" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="TelemetryValueTextBox" Text="45.50" Style="{StaticResource FormTextBoxStyle}"/>

                        <!-- File Attachment Section -->
                        <TextBlock Text="DIAGNOSTIC LOG / PHOTO ATTACHMENT" Style="{StaticResource FormLabelStyle}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="AttachLogButton" Grid.Column="0" Content="Attach Log/Photo" 
                                    Click="AttachLogButton_Click"
                                    Background="#334155" Foreground="#F8FAFC" FontSize="12" 
                                    Padding="12,8" BorderThickness="0" Cursor="Hand"/>
                            <TextBlock x:Name="AttachedFileTextBlock" Grid.Column="1" 
                                       Text="No file attached" VerticalAlignment="Center" 
                                       Margin="10,0,0,0" Foreground="#94A3B8" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        </Grid>

                        <!-- Submit Button -->
                        <Button x:Name="SubmitButton" Content="🚀 Submit Telemetry Data" 
                                Click="SubmitButton_Click" Style="{StaticResource PrimaryActionButtonStyle}" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- RIGHT: DYNAMIC ENGAGEMENT HEATMAP & CONSOLE -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Dynamic Engagement Heatmap Card -->
                    <RowDefinition Height="*"/>    <!-- API Response & Stream Log Console -->
                </Grid.RowDefinitions>

                <!-- DYNAMIC ENGAGEMENT HEATMAP COMPONENT -->
                <Border Grid.Row="0" x:Name="StatusHeatmapBorder" Background="#10B981" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Status Icon Indicator -->
                        <Border Grid.Column="0" Width="50" Height="50" CornerRadius="25" Background="#FFFFFF" Opacity="0.2" Margin="0,0,16,0">
                            <TextBlock x:Name="StatusIconTextBlock" Text="✓" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Status Text Details -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="DYNAMIC ENGAGEMENT HEATMAP STATUS" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" Opacity="0.8"/>
                            <TextBlock x:Name="StatusHeaderTextBlock" Text="GREEN_NORMAL (NOMINAL OPERATIONAL RANGE)" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,2,0,2"/>
                            <TextBlock x:Name="StatusDetailTextBlock" Text="Gateway node operating within safe boundaries. Value threshold below 80.0 limit." FontSize="12" Foreground="#FFFFFF" Opacity="0.9"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- RESPONSE LOG & STREAM CONSOLE -->
                <Border Grid.Row="1" Background="#1E293B" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="API Dispatch Console &amp; Sensor Log Response" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC"/>
                            <Button Content="Clear Console" HorizontalAlignment="Right" Click="ClearConsole_Click"
                                    Background="Transparent" Foreground="#94A3B8" FontSize="11" BorderThickness="0" Cursor="Hand"/>
                        </DockPanel>

                        <TextBox Grid.Row="1" x:Name="ConsoleLogTextBox" IsReadOnly="True" 
                                 Background="#0F172A" Foreground="#38BDF8" BorderBrush="#334155" BorderThickness="1"
                                 Padding="12" FontFamily="Consolas, Cascadia Code, monospace" FontSize="12"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="Wrap"
                                 Text="[READY] SmartX Gateway Client Initialized. Awaiting telemetry dispatch...&#x0a;"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ============================================================== -->
        <!-- MODULE 2: REAL-TIME COMMAND STREAM & HISTORY (PART 2 CORE)      -->
        <!-- ============================================================== -->
        <Grid x:Name="Pillar2CommandStreamGrid" Grid.Row="1" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Data Structure Metric Counters -->
                <RowDefinition Height="Auto"/> <!-- Predictive Action & Recommendation Engine Banner -->
                <RowDefinition Height="Auto"/> <!-- Search & Filter Controls Bar -->
                <RowDefinition Height="*"/>    <!-- Main Split: Live Device Cards + Command Stream/Undo -->
            </Grid.RowDefinitions>

            <!-- 1. DATA STRUCTURE RUNTIME METRICS MONITOR BAR -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 1. Queue<T> FIFO Metric -->
                <Border Grid.Column="0" Style="{StaticResource MetricCardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="FIFO MESSAGE QUEUE" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock x:Name="MetricFifoQueueTextBlock" Text="0 pkts" FontSize="18" FontWeight="Bold" Foreground="#38BDF8" Margin="0,2,0,0"/>
                        <TextBlock Text="Queue&lt;TelemetryPacket&gt;" FontSize="10" Foreground="#64748B"/>
                    </StackPanel>
                </Border>

                <!-- 2. PriorityQueue Critical Alert Metric -->
                <Border Grid.Column="1" Style="{StaticResource MetricCardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="PRIORITY ALERT QUEUE" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock x:Name="MetricPriorityQueueTextBlock" Text="0 bypasses" FontSize="18" FontWeight="Bold" Foreground="#EF4444" Margin="0,2,0,0"/>
                        <TextBlock Text="PriorityQueue&lt;Alert, 1&gt;" FontSize="10" Foreground="#64748B"/>
                    </StackPanel>
                </Border>

                <!-- 3. Stack<T> Undo Depth Metric -->
                <Border Grid.Column="2" Style="{StaticResource MetricCardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="COMMAND UNDO STACK" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock x:Name="MetricUndoStackTextBlock" Text="0 cmds" FontSize="18" FontWeight="Bold" Foreground="#A855F7" Margin="0,2,0,0"/>
                        <TextBlock Text="Stack&lt;DeviceCommand&gt;" FontSize="10" Foreground="#64748B"/>
                    </StackPanel>
                </Border>

                <!-- 4. HashSet<T> Unique Error States -->
                <Border Grid.Column="3" Style="{StaticResource MetricCardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="UNIQUE ACTIVE ERRORS" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock x:Name="MetricActiveErrorsTextBlock" Text="0 unique" FontSize="18" FontWeight="Bold" Foreground="#F59E0B" Margin="0,2,0,0"/>
                        <TextBlock Text="HashSet&lt;string&gt; Deduplicated" FontSize="10" Foreground="#64748B"/>
                    </StackPanel>
                </Border>

                <!-- 5. Dictionary<TKey, TValue> Live Registered Devices O(1) -->
                <Border Grid.Column="4" Style="{StaticResource MetricCardBorderStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="REGISTERED DEVICES" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock x:Name="MetricRegisteredDevicesTextBlock" Text="6 nodes" FontSize="18" FontWeight="Bold" Foreground="#10B981" Margin="0,2,0,0"/>
                        <TextBlock Text="Dictionary&lt;MAC, Dev&gt; O(1)" FontSize="10" Foreground="#64748B"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 2. PREDICTIVE ACTION & RECOMMENDATION ENGINE BANNER ("Automated Insights") -->
            <Border Grid.Row="1" Background="#1E1B4B" CornerRadius="10" BorderBrush="#6366F1" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" Background="#4F46E5" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="AUTOMATED INSIGHT &amp; PREDICTIVE RECOMMENDATION ENGINE" FontSize="11" FontWeight="Bold" Foreground="#A5B4FC"/>
                            <Border x:Name="InsightConfidenceBadge" Background="#312E81" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                <TextBlock x:Name="InsightConfidenceTextBlock" Text="Confidence: 95%" FontSize="10" FontWeight="Bold" Foreground="#C7D2FE"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="InsightTitleTextBlock" Text="Pattern Correlation: Hydroponic Moisture &lt; 20% detected. Proactively recommending irrigation pump trigger." 
                                   FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,3,0,1"/>
                        <TextBlock x:Name="InsightReasonTextBlock" Text="Operator frequently searches 'Pump Alpha' right after moisture alert. Executing suggestion prevents crop stress." 
                                   FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>

                    <!-- One-Click Suggestion Execution Button -->
                    <Button Grid.Column="2" x:Name="ExecuteInsightButton" Content="⚡ Execute Suggested Action" 
                            Click="ExecuteInsightButton_Click"
                            Background="#4F46E5" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold" 
                            Padding="16,10" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <!-- 3. SEARCH & FILTER CONTROLS BAR -->
            <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/> <!-- Search Box -->
                        <ColumnDefinition Width="180"/> <!-- Category Filter -->
                        <ColumnDefinition Width="160"/> <!-- Status Filter -->
                        <ColumnDefinition Width="*"/>   <!-- Action Buttons (Simulate Alert, Undo, Refresh) -->
                    </Grid.ColumnDefinitions>

                    <!-- Search Input (Records user query for pattern learning) -->
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="SEARCH DEVICES / NODES" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,4"/>
                        <TextBox x:Name="DeviceSearchTextBox" Text="" 
                                 TextChanged="DeviceSearchTextBox_TextChanged"
                                 Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1"
                                 Padding="8,6" FontSize="12" CaretBrush="#3B82F6"/>
                    </StackPanel>

                    <!-- Category Filter -->
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="CATEGORY FILTER" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CategoryFilterComboBox" SelectionChanged="FilterComboBox_SelectionChanged" 
                                  SelectedIndex="0" Padding="6,4" FontSize="12" Foreground="#0F172A">
                            <ComboBoxItem Content="All Categories"/>
                            <ComboBoxItem Content="Environmental"/>
                            <ComboBoxItem Content="Power"/>
                            <ComboBoxItem Content="Actuator"/>
                            <ComboBoxItem Content="Hydroponics"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Alert State Filter -->
                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="ALERT STATE" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="StatusFilterComboBox" SelectionChanged="FilterComboBox_SelectionChanged" 
                                  SelectedIndex="0" Padding="6,4" FontSize="12" Foreground="#0F172A">
                            <ComboBoxItem Content="All States"/>
                            <ComboBoxItem Content="Normal"/>
                            <ComboBoxItem Content="Warning"/>
                            <ComboBoxItem Content="Critical"/>
                            <ComboBoxItem Content="Disconnected"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Right-Aligned Action Buttons -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <!-- Simulate High-Priority Alert (Priority Queue Bypass Test) -->
                        <Button Content="🚨 Simulate High-Priority Alert" Click="SimulateAlertButton_Click" 
                                Style="{StaticResource DangerButtonStyle}" Margin="0,0,8,0" ToolTip="Injects critical power surge or moisture drop bypassing standard FIFO queue"/>

                        <!-- Undo Last Command (Stack Implementation) -->
                        <Button x:Name="UndoCommandButton" Content="↺ Undo Last Command" Click="UndoButton_Click" 
                                Style="{StaticResource UndoButtonStyle}" Margin="0,0,8,0" ToolTip="Reverts the last manual override command issued via Stack&lt;T&gt; LIFO"/>

                        <!-- Refresh Button -->
                        <Button Content="🔄 Refresh Stream" Click="RefreshStreamButton_Click" 
                                Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 4. MAIN SPLIT: LIVE DEVICE CARDS (LEFT) + COMMAND STREAM & UNDO (RIGHT) -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>   <!-- Live Device Cards Grid (from Dictionary) -->
                    <ColumnDefinition Width="420"/> <!-- Command History Stack & Timeline (from SortedDictionary) -->
                </Grid.ColumnDefinitions>

                <!-- LEFT: LIVE DEVICE CARDS (O(1) Dictionary Lookup Visualisation) -->
                <Border Grid.Column="0" Background="#1E293B" CornerRadius="10" BorderBrush="#334155" BorderThickness="1" Padding="14" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Live Mesh Nodes &amp; Interactive Override Controls" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC"/>
                            <TextBlock x:Name="DeviceCountBadgeTextBlock" Text="Showing 6 / 6 Devices" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right"/>
                        </DockPanel>

                        <!-- Devices Scroll Area -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="DevicesItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0F172A" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Top: Device Name, MAC, Category & Status Badges -->
                                                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                                    <StackPanel DockPanel.Dock="Left">
                                                        <TextBlock Text="{Binding DeviceName}" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC"/>
                                                        <TextBlock Text="{Binding MacAddress}" FontSize="11" Foreground="#94A3B8" FontFamily="Consolas"/>
                                                    </StackPanel>

                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <!-- Category Badge -->
                                                        <Border Background="#1E293B" CornerRadius="4" Padding="8,3" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8"/>
                                                        </Border>
                                                        <!-- Status Badge -->
                                                        <Border Background="{Binding StatusColor}" CornerRadius="4" Padding="8,3">
                                                            <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                        </Border>
                                                    </StackPanel>
                                                </DockPanel>

                                                <!-- Middle: Live Telemetry Value & Device Sub-States -->
                                                <Border Grid.Row="1" Background="#1E293B" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Telemetry Reading -->
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="LIVE TELEMETRY" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                                                            <TextBlock Text="{Binding DisplayValue}" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC"/>
                                                        </StackPanel>

                                                        <!-- Relay State -->
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="RELAY STATE" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                                                            <TextBlock Text="{Binding RelayState}" FontSize="12" FontWeight="Bold" Foreground="{Binding RelayColor}"/>
                                                        </StackPanel>

                                                        <!-- Pump State -->
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="PUMP STATE" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                                                            <TextBlock Text="{Binding PumpState}" FontSize="12" FontWeight="Bold" Foreground="{Binding PumpColor}"/>
                                                        </StackPanel>

                                                        <!-- Power Draw -->
                                                        <StackPanel Grid.Column="3">
                                                            <TextBlock Text="POWER LOAD" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                                                            <TextBlock Text="{Binding PowerDrawWatts, StringFormat={}{0:F1} W}" FontSize="12" FontWeight="Bold" Foreground="#94A3B8"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- Bottom: Manual Override Action Controls -->
                                                <DockPanel Grid.Row="2">
                                                    <TextBlock Text="{Binding Location}" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" DockPanel.Dock="Left"/>

                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <!-- Toggle Relay Override -->
                                                        <Button Content="⚡ Relay" Tag="{Binding MacAddress}" Click="DeviceToggleRelay_Click" 
                                                                Background="#334155" Foreground="#F8FAFC" FontSize="11" FontWeight="SemiBold" 
                                                                Padding="10,5" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0">
                                                            <Button.Resources>
                                                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                                            </Button.Resources>
                                                        </Button>

                                                        <!-- Toggle Pump Override -->
                                                        <Button Content="💧 Pump" Tag="{Binding MacAddress}" Click="DeviceTogglePump_Click" 
                                                                Background="#2563EB" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold" 
                                                                Padding="10,5" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0">
                                                            <Button.Resources>
                                                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                                            </Button.Resources>
                                                        </Button>

                                                        <!-- Emergency Stop Override -->
                                                        <Button Content="🛑 Isolate" Tag="{Binding MacAddress}" Click="DeviceEmergencyStop_Click" 
                                                                Background="#DC2626" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" 
                                                                Padding="10,5" BorderThickness="0" Cursor="Hand">
                                                            <Button.Resources>
                                                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                                            </Button.Resources>
                                                        </Button>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- RIGHT: COMMAND HISTORY (STACK) & TIMELINE (SORTED DICTIONARY) -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/> <!-- Top: Command History & Undo Stack Inspector -->
                        <RowDefinition Height="*"/> <!-- Bottom: Chronological Telemetry Timeline Logs -->
                    </Grid.RowDefinitions>

                    <!-- TOP: COMMAND HISTORY & UNDO STACK (Stack<DeviceCommand>) -->
                    <Border Grid.Row="0" Background="#1E293B" CornerRadius="10" BorderBrush="#334155" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="Command History Stack (LIFO)" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC"/>
                                <Border Background="#8B5CF6" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                    <TextBlock x:Name="UndoStackDepthBadge" Text="Stack: 0" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </Border>
                            </DockPanel>

                            <!-- Command Stack List -->
                            <ListBox Grid.Row="1" x:Name="CommandHistoryListBox" 
                                     Background="#0F172A" Foreground="#E2E8F0" BorderBrush="#334155" BorderThickness="1" 
                                     FontFamily="Consolas, monospace" FontSize="11" Padding="4">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FormattedDescription}" TextWrapping="Wrap" Margin="0,2"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Quick Undo Action Bar -->
                            <DockPanel Grid.Row="2" Margin="0,8,0,0">
                                <TextBlock x:Name="LastActionStatusTextBlock" Text="Ready to issue manual commands." FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" DockPanel.Dock="Left" TextTrimming="CharacterEllipsis" MaxWidth="250"/>
                                <Button Content="↺ Undo Last" Click="UndoButton_Click" 
                                        Style="{StaticResource UndoButtonStyle}" FontSize="11" Padding="10,5" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <!-- BOTTOM: CHRONOLOGICAL SENSOR TIMELINE (SortedDictionary<DateTime, HistoricalLog>) -->
                    <Border Grid.Row="1" Background="#1E293B" CornerRadius="10" BorderBrush="#334155" BorderThickness="1" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="Sorted Timeline Logs (SortedDictionary)" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC"/>
                                <TextBlock Text="Chronological Order" FontSize="10" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                            </DockPanel>

                            <!-- Chronological Event Stream -->
                            <ListBox Grid.Row="1" x:Name="TimelineListBox" 
                                     Background="#0F172A" Foreground="#38BDF8" BorderBrush="#334155" BorderThickness="1" 
                                     FontFamily="Consolas, monospace" FontSize="11" Padding="4">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <Border Background="{Binding QueueBadgeColor}" CornerRadius="3" Padding="4,1" Margin="0,0,6,0" DockPanel.Dock="Left">
                                                <TextBlock Text="{Binding ProcessingQueue}" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            </Border>
                                            <TextBlock Text="{Binding FormattedLog}" TextWrapping="Wrap" Foreground="#E2E8F0"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ============================================================== -->
        <!-- MODULE 3: NETWORK TOPOLOGY & MESH ROUTING (POE FINAL PREVIEW)   -->
        <!-- ============================================================== -->
        <Grid x:Name="Pillar3TopologyGrid" Grid.Row="1" Visibility="Collapsed">
            <Border Background="#1E293B" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Pillar 3: Network Topology &amp; Multi-Hop Mesh Routing Engine" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <TextBlock Text="Preview of dynamic mesh routing algorithms, Dijkstra shortest path, and spatial graph topology for final PoE delivery." FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Interactive Topology Graph Preview Canvas -->
                    <Border Grid.Row="1" Background="#0F172A" CornerRadius="10" BorderBrush="#334155" BorderThickness="1" Padding="20">
                        <Grid>
                            <!-- Visual Topology Nodes Layout -->
                            <!-- Master Gateway -->
                            <Border Width="160" Height="80" Background="#1E40AF" CornerRadius="8" BorderBrush="#60A5FA" BorderThickness="2"
                                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="📡 GATEWAY ROOT" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Sector-7 Coordinator" FontSize="10" Foreground="#93C5FD" HorizontalAlignment="Center"/>
                                    <TextBlock Text="IP: 192.168.1.1 (Online)" FontSize="9" Foreground="#10B981" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Sub-Hop Nodes -->
                            <Border Width="140" Height="70" Background="#1E293B" CornerRadius="8" BorderBrush="#10B981" BorderThickness="1"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="80,0,0,0">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="🌿 ESP32-Hydro-01" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                    <TextBlock Text="RSSI: -58 dBm (Hop 1)" FontSize="9" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Status: Active Mesh Node" FontSize="9" Foreground="#10B981" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Width="140" Height="70" Background="#1E293B" CornerRadius="8" BorderBrush="#3B82F6" BorderThickness="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="⚡ Substation Meter" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                    <TextBlock Text="RSSI: -62 dBm (Hop 1)" FontSize="9" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Status: Mesh Router" FontSize="9" Foreground="#10B981" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Width="140" Height="70" Background="#1E293B" CornerRadius="8" BorderBrush="#10B981" BorderThickness="1"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,80,0">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="🌡️ Climate Node 03" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                    <TextBlock Text="RSSI: -71 dBm (Hop 2)" FontSize="9" Foreground="#F59E0B" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Status: Edge Leaf" FontSize="9" Foreground="#10B981" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Actuator Leaf Nodes -->
                            <Border Width="140" Height="70" Background="#1E293B" CornerRadius="8" BorderBrush="#8B5CF6" BorderThickness="1"
                                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="140,0,0,30">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="💧 Water Pump Alpha" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Relayed via Hydro-01" FontSize="9" Foreground="#A78BFA" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Actuator Online" FontSize="9" Foreground="#10B981" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Width="140" Height="70" Background="#1E293B" CornerRadius="8" BorderBrush="#8B5CF6" BorderThickness="1"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,140,30">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="⚡ Smart Relay 01" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Relayed via Substation" FontSize="9" Foreground="#A78BFA" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Actuator Online" FontSize="9" Foreground="#10B981" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Footer Note -->
                    <Border Grid.Row="2" Background="#0F172A" CornerRadius="8" Padding="12" Margin="0,16,0,0">
                        <TextBlock Text="ℹ️ Note: Full Dynamic Dijkstra Multi-Hop Routing, Mesh Graph Traversal, and Failover Auto-Rerouting will be delivered in the Final Portfolio of Evidence (PoE)."
                                   FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
