<Window x:Class="SmartX.Dashboard.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartX-IoT-Mesh - Gateway Portal Authentication" Height="680" Width="500"
        MinHeight="550" MinWidth="450"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#0F172A" Foreground="#F8FAFC"
        FontFamily="Segoe UI, Roboto, sans-serif">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Branding / Title -->
            <RowDefinition Height="*"/>    <!-- Main Login Card -->
            <RowDefinition Height="Auto"/> <!-- Footer Info -->
        </Grid.RowDefinitions>

        <!-- BRANDING HEADER -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,5,0,16">
            <Border Width="50" Height="50" CornerRadius="25" Background="#1E40AF" HorizontalAlignment="Center" Margin="0,0,0,8">
                <TextBlock Text="⚡" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="SmartX-IoT-Mesh" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center"/>
            <TextBlock Text="Edge Gateway Control Console" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- MAIN LOGIN CARD -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="16" BorderBrush="#334155" BorderThickness="1" Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="0" Color="#000000" Opacity="0.5"/>
            </Border.Effect>
            
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel VerticalAlignment="Center" Margin="4">
                    <TextBlock Text="Portal Authentication" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,10"/>

                    <!-- DUMMY CREDENTIALS HELPER BANNER -->
                    <Border Background="#0F172A" CornerRadius="10" BorderBrush="#3B82F6" BorderThickness="1" Padding="12" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="🔑 DEMO ACCESS CREDENTIALS" FontSize="11" FontWeight="Bold" Foreground="#60A5FA"/>
                                <Button Content="Auto-Fill" HorizontalAlignment="Right" Click="AutoFill_Click"
                                        Background="#2563EB" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold" 
                                        Padding="8,2" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </DockPanel>
                            <TextBlock Text="Username: admin@smartx.io" FontSize="12" FontFamily="Consolas, monospace" Foreground="#E2E8F0"/>
                            <TextBlock Text="Password: AdminPassword123!" FontSize="12" FontFamily="Consolas, monospace" Foreground="#E2E8F0" Margin="0,2,0,0"/>
                            <TextBlock Text="(Or use 'admin' / 'admin123')" FontSize="10" Foreground="#94A3B8" Margin="0,4,0,0" FontStyle="Italic"/>
                        </StackPanel>
                    </Border>

                    <!-- USERNAME INPUT -->
                    <TextBlock Text="USER EMAIL / USERNAME" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <TextBox x:Name="UsernameTextBox" Text="admin@smartx.io" 
                             Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1"
                             Padding="10,7" FontSize="13" Margin="0,0,0,12" CaretBrush="#3B82F6"/>

                    <!-- PASSWORD INPUT -->
                    <TextBlock Text="SECURITY PASSWORD" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="PasswordBox" 
                                 Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1"
                                 Padding="10,7" FontSize="13" Margin="0,0,0,14" CaretBrush="#3B82F6"/>

                    <!-- ERROR MESSAGE DISPLAY -->
                    <TextBlock x:Name="ErrorMessageTextBlock" Text="" FontSize="11" Foreground="#EF4444" 
                               FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>

                    <!-- LOGIN SUBMIT BUTTON -->
                    <Button x:Name="LoginButton" Content="🔓 Authenticate &amp; Launch Console" Click="LoginButton_Click"
                            Background="#2563EB" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"
                            Padding="0,12" BorderThickness="0" Cursor="Hand" Margin="0,4,0,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- FOOTER INFO -->
        <TextBlock Grid.Row="2" Text="SmartX Mesh Security Gateway v1.0 • Authorized Personnel Only" 
                   FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,12,0,0"/>
    </Grid>
</Window>
